# Шаблон списка исключений форматтера. Кладётся в корень проекта как
# `.prettierignore`. Без него `format:check` краснеет на файлах, которых никто
# не писал, и цепочку проверок начинают запускать реже — то есть проверка
# отменяет не себя, а привычку её гонять.

# Сборка, покрытие, зависимости, статика — не авторский код.
dist
coverage
node_modules
public

# Файл блокировки менеджера пакетов: его формат задаёт менеджер.
package-lock.json

# Разметка здесь — свёрстанная руками проза: документация, решения, база
# знаний. Форматтер её не улучшает, он доливает в неё пустые строки и ломает
# ручные переносы, на которых держится читаемость таблиц.
*.md

# Папки инструментов, порождающих копии дерева: песочница мутационного
# прогона и его отчёты. Не исключив их, форматтер проверяет проект дважды.
.stryker-tmp
reports

# <ПРОЕКТНОЕ: сгенерированные файлы, вендорные копии, всё, чей формат задаёт
# не этот репозиторий.>
