import { render, screen } from "@testing-library/react";
import { describe, expect, it } from "vitest";

import { App } from "../App";

describe("App", () => {
  it("renders its heading", () => {
    render(<App />);
    expect(screen.getByRole("heading", { name: "It works" })).toBeDefined();
  });

  // Second render on purpose: without the cleanup in `setup.ts` it finds the previous copy.
  it("renders the same heading again, with nothing left over from before", () => {
    render(<App />);
    expect(screen.getAllByRole("heading", { name: "It works" })).toHaveLength(
      1,
    );
  });
});
