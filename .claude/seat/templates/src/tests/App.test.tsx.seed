import { render, screen } from "@testing-library/react";
import { describe, expect, it } from "vitest";

import { App } from "../App";

describe("App", () => {
  it("renders its heading", () => {
    render(<App />);
    expect(screen.getByRole("heading", { name: "It works" })).toBeDefined();
  });

  // A second test that renders, on purpose.
  //
  // It is what makes `setup.ts` load-bearing rather than decorative: without
  // the cleanup registered there, this render finds the previous test's copy
  // still in the document and the query fails with "found multiple elements".
  // A single-test file never shows that, and the failure, when it finally
  // arrives, points at the query rather than at the leftover.
  it("renders the same heading again, with nothing left over from before", () => {
    render(<App />);
    expect(screen.getAllByRole("heading", { name: "It works" })).toHaveLength(
      1,
    );
  });
});
