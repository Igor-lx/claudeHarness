{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Why these settings: `.claude/seat/stryker.config-why.md`.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "related": false
  },
  "reporters": ["html", "clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "ignorePatterns": [".claude"],
  "mutate": [
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "!src/**/tests/**",
    "!src/**/*.test.*"
  ],
  "thresholds": {
    "break": null
  },
  "mutator": {
    "excludedMutations": ["StringLiteral"]
  }
}
