{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2",
    "npm": ">=11.21.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && node .claude/tools/graph.mjs verify",
    "mutate": "stryker run"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.13.0",
    "axios": "1.20.0",
    "clsx": "2.1.1",
    "i18next": "26.5.6",
