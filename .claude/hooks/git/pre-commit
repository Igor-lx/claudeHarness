#!/bin/sh
# Ворота перед коммитом: правка кода без свода по планке не проходит.
#
# Лежит в репозитории, а не в `.git/hooks`: те с клоном не едут. Посадка
# указывает на эту папку настройкой `core.hooksPath`, и тогда хук приезжает
# вместе с проектом.
#
# Отменяется флагом `--no-verify` — это не оговорка, а устройство git. Поэтому
# ворота не единственный слой: обход ловит сверка «Коммит с кодом накрыт
# сводом», которая ходит по истории и обход делает вечно красным.
exec node .claude/tools/graph.mjs gate
