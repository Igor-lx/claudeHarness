#!/bin/sh
# Строка серии в сообщении коммита: печать свода, часть из скольких и дерево.
# По ней ревизия сводов по истории узнаёт коммит части серии.
#
# Свой хук проекта в служебной папке git посадка не отключает: настройка
# `core.hooksPath` уводит git сюда, и хук зовётся отсюда первым.
own="$(git rev-parse --git-common-dir)/hooks/prepare-commit-msg"
if [ -x "$own" ]; then "$own" "$@" || exit $?; fi
# Инструмент — от самого хука, как у ворот перед коммитом.
exec node "$(dirname "$0")/../../tools/graph.mjs" gate --message "$1"
